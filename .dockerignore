# Keep the build context small and reproducible. Node deps and the browser
# cache are rebuilt inside the image; local state must never leak in.
.git
node_modules
.playwright
db
raw
output
models
.cache
.env
*.log
# Auto-applier personal data: local only, never baked into the image.
applicant.yml
applicant-memory.md*
.DS_Store

# Stray duplicate downloads (the "name (1).ext" files).
*\ (1).*
**/*\ (1).*
